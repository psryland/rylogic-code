<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

	<!-- <Import Project="$(SolutionDir)Directory.Build.props" /> -->

	<!-- Globals -->
	<PropertyGroup Label="Globals">
		<ProjectName>audio</ProjectName>
		<TargetName>audio-static</TargetName>
		<RootNamespace>pr::audio</RootNamespace>
		<ProjectGuid>{7CC6930C-889B-4B6E-958F-BEE16ED2FF44}</ProjectGuid>
		<ConfigurationType>StaticLibrary</ConfigurationType>
	</PropertyGroup>

	<!-- Property Sheets -->
	<Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
	<Import Project="$(PropsPath)build_configurations.props" />
	<Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
	<Import Project="$(PropsPath)lib.props" />

	<!-- Build options -->
	<ItemDefinitionGroup>
		<ClCompile>
			<PrecompiledHeader>Use</PrecompiledHeader>
			<PrecompiledHeaderFile>"pr/audio/forward.h"</PrecompiledHeaderFile>
			<PreprocessorDefinitions>PR_MATHS_USE_DIRECTMATH=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
			<AdditionalIncludeDirectories>
				;$(RylogicRoot)projects\rylogic
				;$(RylogicRoot)sdk\ogg\include
				;$(RylogicRoot)sdk\vorbis\include
				;%(AdditionalIncludeDirectories)
			</AdditionalIncludeDirectories>
		</ClCompile>
	</ItemDefinitionGroup>

	<!-- Files -->
	<ItemGroup>
		<ClInclude Include="$(RylogicRoot)include\pr\audio\audio.h" />
		<ClInclude Include="$(RylogicRoot)include\pr\audio\engine.h" />
		<ClInclude Include="$(RylogicRoot)include\pr\audio\forward.h" />
		<ClInclude Include="$(RylogicRoot)include\pr\audio\synth\note.h" />
		<ClInclude Include="$(RylogicRoot)include\pr\audio\synth\synth.h" />
		<ClInclude Include="$(RylogicRoot)include\pr\audio\types.h" />
		<ClInclude Include="engine\handle_util.h" />
		<ClInclude Include="engine\stream.h" />
		<ClCompile Include="engine\engine.cpp">
			<PrecompiledHeader>Create</PrecompiledHeader>
		</ClCompile>
		<ClCompile Include="engine\stream.cpp" />
		<ClCompile Include="$(RylogicRoot)sdk\ogg\ogg.c">
			<PrecompiledHeader>NotUsing</PrecompiledHeader>
			<AdditionalIncludeDirectories>$(RylogicRoot)sdk\ogg\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
		</ClCompile>
		<ClCompile Include="$(RylogicRoot)sdk\vorbis\vorbis.c">
			<PrecompiledHeader>NotUsing</PrecompiledHeader>
			<AdditionalIncludeDirectories>$(RylogicRoot)sdk\ogg\include;$(RylogicRoot)sdk\vorbis\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
		</ClCompile>
		<None Include="readme.md" />
		<None Include="third-party-notices.txt" />
	</ItemGroup>
	<Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>