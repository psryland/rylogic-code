<Window
	x:Class="Rylogic.Gui.WPF.View3dMoveObjectsUI"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d"
	Title="Move Objects"
	WindowStyle="ToolWindow"
	WindowStartupLocation="CenterOwner"
	SizeToContent="WidthAndHeight"
	ResizeMode="NoResize"
	>
	<Grid
		Margin="8"
		>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Coordinate space toggle -->
		<StackPanel
			Grid.Row="0"
			Orientation="Horizontal"
			Margin="0,0,0,8"
			>
			<TextBlock
				Text="Space:"
				VerticalAlignment="Center"
				Margin="0,0,8,0"
				/>
			<RadioButton
				Content="World"
				IsChecked="{Binding IsWorldSpace}"
				VerticalAlignment="Center"
				Margin="0,0,12,0"
				/>
			<RadioButton
				Content="Parent"
				IsChecked="{Binding IsParentSpace}"
				VerticalAlignment="Center"
				Margin="0,0,16,0"
				/>
			<TextBlock
				Text="{Binding ObjectNames}"
				VerticalAlignment="Center"
				Foreground="Gray"
				FontStyle="Italic"
				TextTrimming="CharacterEllipsis"
				MaxWidth="250"
				/>
		</StackPanel>

		<!-- Position text entry -->
		<Grid
			Grid.Row="1"
			Margin="0,0,0,8"
			>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="8"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="8"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<TextBlock
				Grid.Column="0"
				Text="X:"
				VerticalAlignment="Center"
				Margin="0,0,4,0"
				/>
			<TextBox
				Grid.Column="1"
				Text="{Binding PositionX, StringFormat={}{0:G6}, UpdateSourceTrigger=LostFocus}"
				MinWidth="80"
				HorizontalContentAlignment="Right"
				VerticalAlignment="Center"
				x:Name="m_tb_x"
				/>

			<TextBlock
				Grid.Column="3"
				Text="Y:"
				VerticalAlignment="Center"
				Margin="0,0,4,0"
				/>
			<TextBox
				Grid.Column="4"
				Text="{Binding PositionY, StringFormat={}{0:G6}, UpdateSourceTrigger=LostFocus}"
				MinWidth="80"
				HorizontalContentAlignment="Right"
				VerticalAlignment="Center"
				x:Name="m_tb_y"
				/>

			<TextBlock
				Grid.Column="6"
				Text="Z:"
				VerticalAlignment="Center"
				Margin="0,0,4,0"
				/>
			<TextBox
				Grid.Column="7"
				Text="{Binding PositionZ, StringFormat={}{0:G6}, UpdateSourceTrigger=LostFocus}"
				MinWidth="80"
				HorizontalContentAlignment="Right"
				VerticalAlignment="Center"
				x:Name="m_tb_z"
				/>
		</Grid>

		<!-- Touch pads -->
		<StackPanel
			Grid.Row="2"
			Orientation="Horizontal"
			HorizontalAlignment="Center"
			Margin="0,0,0,8"
			>

			<!-- XY plane touch pad -->
			<Border
				BorderBrush="Gray"
				BorderThickness="1"
				Margin="4"
				>
				<Canvas
					Width="150"
					Height="150"
					Background="#FFE0E0E0"
					ClipToBounds="True"
					Tag="XY"
					MouseLeftButtonDown="OnTouchPadMouseDown"
					MouseMove="OnTouchPadMouseMove"
					MouseLeftButtonUp="OnTouchPadMouseUp"
					MouseWheel="OnTouchPadMouseWheel"
					x:Name="m_pad_xy"
					/>
			</Border>

			<!-- YZ plane touch pad -->
			<Border
				BorderBrush="Gray"
				BorderThickness="1"
				Margin="4"
				>
				<Canvas
					Width="150"
					Height="150"
					Background="#FFE0E0E0"
					ClipToBounds="True"
					Tag="YZ"
					MouseLeftButtonDown="OnTouchPadMouseDown"
					MouseMove="OnTouchPadMouseMove"
					MouseLeftButtonUp="OnTouchPadMouseUp"
					MouseWheel="OnTouchPadMouseWheel"
					x:Name="m_pad_yz"
					/>
			</Border>

			<!-- ZX plane touch pad -->
			<Border
				BorderBrush="Gray"
				BorderThickness="1"
				Margin="4"
				>
				<Canvas
					Width="150"
					Height="150"
					Background="#FFE0E0E0"
					ClipToBounds="True"
					Tag="ZX"
					MouseLeftButtonDown="OnTouchPadMouseDown"
					MouseMove="OnTouchPadMouseMove"
					MouseLeftButtonUp="OnTouchPadMouseUp"
					MouseWheel="OnTouchPadMouseWheel"
					x:Name="m_pad_zx"
					/>
			</Border>
		</StackPanel>

		<!-- OK button -->
		<Button
			Grid.Row="3"
			Content="OK"
			Command="{Binding Accept}"
			HorizontalAlignment="Right"
			MinWidth="80"
			Margin="0,4,0,0"
			/>
	</Grid>
</Window>
