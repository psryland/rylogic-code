<UserControl
	x:Class="Rylogic.Gui.WPF.View3dObjectManagerUI"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:gui="clr-namespace:Rylogic.Gui.WPF;assembly=Rylogic.Gui.WPF"
	xmlns:conv="clr-namespace:Rylogic.Gui.WPF.Converters;assembly=Rylogic.Gui.WPF"
	xmlns:local="clr-namespace:Rylogic.Gui.WPF"
	mc:Ignorable="d" 
	d:DesignHeight="450"
	d:DesignWidth="800"
	>
	<UserControl.Resources>
		<ResourceDictionary>
			<BitmapImage x:Key="plus" UriSource="/Rylogic.Gui.WPF;component/res/plus1.png"/>
			<BitmapImage x:Key="minus" UriSource="/Rylogic.Gui.WPF;component/res/minus1.png"/>
			<BitmapImage x:Key="eye_visible" UriSource="/Rylogic.Gui.WPF;component/res/eye_visible.png"/>
			<BitmapImage x:Key="eye_hidden" UriSource="/Rylogic.Gui.WPF;component/res/eye_hidden.png"/>

			<!-- Chromeless toggle button (no hover/press effects) -->
			<Style x:Key="ChromelessToggleButton" TargetType="{x:Type ToggleButton}">
				<Setter Property="Background" Value="Transparent"/>
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="{x:Type ToggleButton}">
							<Border
								Background="{TemplateBinding Background}"
								>
								<ContentPresenter
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									/>
							</Border>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>

			<!-- Context menu for the list -->
			<ContextMenu
				x:Key="ObjectManagerListCMenu"
				DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
				>
				<MenuItem
					Header="Visibility"
					>
					<MenuItem
						Header="Show All"
						Command="{Binding SetVisibility}"
						CommandParameter="{x:Static local:ESetVisibleCmd.ShowAll}"
						/>
					<MenuItem
						Header="Hide All"
						Command="{Binding SetVisibility}"
						CommandParameter="{x:Static local:ESetVisibleCmd.HideAll}"
						/>
					<Separator/>
					<MenuItem
						Header="Show Others"
						Command="{Binding SetVisibility}"
						CommandParameter="{x:Static local:ESetVisibleCmd.ShowOthers}"
						/>
					<MenuItem
						Header="Hide Others"
						Command="{Binding SetVisibility}"
						CommandParameter="{x:Static local:ESetVisibleCmd.HideOthers}"
						/>
					<MenuItem
						Header="Toggle Others"
						Command="{Binding SetVisibility}"
						CommandParameter="{x:Static local:ESetVisibleCmd.ToggleOthers}"
						/>
					<Separator/>
					<MenuItem
						Header="Show Selected"
						Command="{Binding SetVisibility}"
						CommandParameter="{x:Static local:ESetVisibleCmd.ShowSelected}"
						/>
					<MenuItem
						Header="Hide Selected"
						Command="{Binding SetVisibility}"
						CommandParameter="{x:Static local:ESetVisibleCmd.HideSelected}"
						/>
					<MenuItem
						Header="Toggle Selected"
						Command="{Binding SetVisibility}"
						CommandParameter="{x:Static local:ESetVisibleCmd.ToggleSelected}"
						/>
				</MenuItem>
				<MenuItem
					Header="State"
					IsEnabled="{Binding FirstSelected, Converter={conv:NotNull}}"
					>
					<MenuItem
						Header="Show Normals"
						IsChecked="{Binding FirstSelected.ShowNormals, FallbackValue=False}"
						Command="{Binding ToggleShowNormals}"
						/>
				</MenuItem>
			</ContextMenu>
		</ResourceDictionary>
	</UserControl.Resources>
	<UserControl.InputBindings>
		<KeyBinding
			Key="F6"
			Command="{Binding FocusPatternFilter}"
			/>
	</UserControl.InputBindings>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Filter bar -->
		<Grid
			Grid.Row="0"
			>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>
			<Grid.Resources>
				<Style x:Key="ExpandButtonStyle" TargetType="{x:Type Button}">
					<Setter Property="Background" Value="Transparent"/>
					<Setter Property="BorderThickness" Value="0"/>
					<Setter Property="MaxHeight" Value="22"/>
					<Setter Property="Margin" Value="2"/>
				</Style>
			</Grid.Resources>

			<!-- Expand All button -->
			<Button
				Grid.Column="0"
				Command="{Binding ExpandAll}"
				Style="{StaticResource ExpandButtonStyle}"
				>
				<Image
					Source="{StaticResource plus}"
					RenderOptions.BitmapScalingMode="HighQuality"
					/>
			</Button>

			<!-- Collapse All button -->
			<Button
				Grid.Column="1"
				Command="{Binding CollapseAll}"
				Style="{StaticResource ExpandButtonStyle}"
				>
				<Image
					Source="{StaticResource minus}"
					RenderOptions.BitmapScalingMode="HighQuality"
					/>
			</Button>

			<!-- Filter Pattern -->
			<gui:PatternFilter
				Grid.Column="2"
				Command="{Binding ApplyFilter}"
				Height="24"
				Margin="1"
				x:Name="m_pattern_filter"
				/>
		</Grid>

		<!-- Virtualised flat tree list -->
		<ListView
			Grid.Row="1"
			ItemsSource="{Binding VisibleNodes}"
			ContextMenu="{StaticResource ObjectManagerListCMenu}"
			SelectionChanged="HandleSelectionChanged"
			SelectionMode="Extended"
			VirtualizingStackPanel.IsVirtualizing="True"
			VirtualizingStackPanel.VirtualizationMode="Recycling"
			ScrollViewer.IsDeferredScrollingEnabled="True"
			BorderThickness="0"
			Margin="2"
			x:Name="m_list"
			>
			<!-- Key Bindings -->
			<ListView.InputBindings>
				<KeyBinding
					Key="Space"
					Command="{Binding SetVisibility}"
					CommandParameter="{x:Static local:ESetVisibleCmd.ToggleSelected}"
					/>
				<KeyBinding
					Key="Space"
					Modifiers="Ctrl"
					Command="{Binding SetVisibility}"
					CommandParameter="{x:Static local:ESetVisibleCmd.ShowSelected}"
					/>
				<KeyBinding
					Key="Space"
					Modifiers="Ctrl+Shift"
					Command="{Binding SetVisibility}"
					CommandParameter="{x:Static local:ESetVisibleCmd.HideSelected}"
					/>
				<KeyBinding
					Key="W"
					Command="{Binding SetWireframe}"
					CommandParameter="0"
					/>
				<KeyBinding
					Key="W"
					Modifiers="Ctrl"
					Command="{Binding SetWireframe}"
					CommandParameter="+1"
					/>
				<KeyBinding
					Key="W"
					Modifiers="Ctrl+Shift"
					Command="{Binding SetWireframe}"
					CommandParameter="-1"
					/>
			</ListView.InputBindings>

			<!-- GridView for column headers -->
			<ListView.View>
				<GridView>

					<!-- Name column (with indent + expand toggle) -->
					<GridViewColumn
						Header="Name"
						Width="250"
						>
						<GridViewColumn.CellTemplate>
							<DataTemplate>
								<StackPanel
									Orientation="Horizontal"
									Margin="{Binding Indent}"
									>
									<!-- Expand/collapse toggle -->
									<ToggleButton
										Style="{StaticResource ChromelessToggleButton}"
										IsChecked="{Binding IsExpanded, Mode=OneWay}"
										Visibility="{Binding HasChildren, Converter={conv:BoolToVisible}}"
										Command="{Binding DataContext.ToggleExpand, RelativeSource={RelativeSource AncestorType=ListView}}"
										CommandParameter="{Binding}"
										Padding="0"
										Width="8"
										Height="12"
										VerticalAlignment="Center"
										>
										<TextBlock
											FontSize="7"
											VerticalAlignment="Center"
											HorizontalAlignment="Center"
											>
											<TextBlock.Style>
												<Style TargetType="TextBlock">
													<Setter Property="Text" Value="▶"/>
													<Style.Triggers>
														<DataTrigger
															Binding="{Binding IsExpanded}"
															Value="True"
															>
															<Setter Property="Text" Value="▼"/>
														</DataTrigger>
													</Style.Triggers>
												</Style>
											</TextBlock.Style>
										</TextBlock>
									</ToggleButton>

									<!-- Spacer for leaf nodes -->
									<Border
										Width="8"
										Visibility="{Binding HasChildren, Converter={conv:BoolToVisible}, ConverterParameter=invert}"
										/>

									<TextBlock
										Text="{Binding Name}"
										VerticalAlignment="Center"
										Margin="1,0,0,0"
										/>
								</StackPanel>
							</DataTemplate>
						</GridViewColumn.CellTemplate>
					</GridViewColumn>

					<!-- Visibility column (eye toggle) -->
					<GridViewColumn
						Header="Vis"
						Width="40"
						>
						<GridViewColumn.CellTemplate>
							<DataTemplate>
								<ToggleButton
									Style="{StaticResource ChromelessToggleButton}"
									IsChecked="{Binding Visible}"
									Click="OnEyeToggleClick"
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									>
									<Image
										Source="{Binding Flags, Converter={conv:EnumSelect}, ConverterParameter='Hidden:eye_hidden|eye_visible'}"
										RenderOptions.BitmapScalingMode="Fant"
										Height="12"
										/>
								</ToggleButton>
							</DataTemplate>
						</GridViewColumn.CellTemplate>
					</GridViewColumn>

					<!-- Type column -->
					<GridViewColumn
						Header="Type"
						Width="80"
						>
						<GridViewColumn.CellTemplate>
							<DataTemplate>
								<TextBlock
									Text="{Binding Type}"
									VerticalAlignment="Center"
									Margin="3,0,3,0"
									/>
							</DataTemplate>
						</GridViewColumn.CellTemplate>
					</GridViewColumn>

					<!-- Colour column -->
					<GridViewColumn
						Header="Colour"
						Width="80"
						>
						<GridViewColumn.CellTemplate>
							<DataTemplate>
								<Border
									Background="{Binding ColourValue, Converter={conv:ColourToBrush}}"
									MouseLeftButtonDown="OnColourDoubleClick"
									Padding="3,0"
									>
									<TextBlock
										Text="{Binding Colour}"
										Foreground="{Binding ColourValue, Converter={conv:TextOverColourBrush}}"
										VerticalAlignment="Center"
										/>
								</Border>
							</DataTemplate>
						</GridViewColumn.CellTemplate>
					</GridViewColumn>

				</GridView>
			</ListView.View>

			<!-- Full-row selection style with flat colours (no gradient) -->
			<ListView.ItemContainerStyle>
				<Style TargetType="ListViewItem">
					<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
					<Setter Property="Padding" Value="0"/>
					<Setter Property="Margin" Value="0"/>
					<Setter Property="MinHeight" Value="8"/>
					<Setter Property="Template">
						<Setter.Value>
							<ControlTemplate TargetType="ListViewItem">
								<Border
									x:Name="Bd"
									Background="{TemplateBinding Background}"
									BorderBrush="{TemplateBinding BorderBrush}"
									BorderThickness="{TemplateBinding BorderThickness}"
									Padding="{TemplateBinding Padding}"
									SnapsToDevicePixels="True"
									>
									<GridViewRowPresenter
										HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
										VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
										/>
								</Border>
								<ControlTemplate.Triggers>
									<Trigger Property="IsSelected" Value="True">
										<Setter TargetName="Bd" Property="Background" Value="#FFC4D8E0"/>
									</Trigger>
									<MultiTrigger>
										<MultiTrigger.Conditions>
											<Condition Property="IsSelected" Value="True"/>
											<Condition Property="IsMouseOver" Value="True"/>
										</MultiTrigger.Conditions>
										<Setter TargetName="Bd" Property="Background" Value="#FFA0BAD4"/>
									</MultiTrigger>
									<Trigger Property="IsMouseOver" Value="True">
										<Setter TargetName="Bd" Property="Background" Value="#FFDCE6F0"/>
									</Trigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</Setter.Value>
					</Setter>
				</Style>
			</ListView.ItemContainerStyle>
		</ListView>

		<!-- Status -->
		<StatusBar
			Grid.Row="2"
			>
			<TextBlock Text="Idle"/>
		</StatusBar>

	</Grid>
</UserControl>
