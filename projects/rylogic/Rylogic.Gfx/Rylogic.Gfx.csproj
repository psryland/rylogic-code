<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Library</OutputType>
		<RootNamespace>Rylogic.Gfx</RootNamespace>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
	</PropertyGroup>

	<!-- Assembly Properties -->
	<PropertyGroup>
		<ApplicationIcon>icon_128x128.ico</ApplicationIcon>
		<Version>$(RylogicLibraryVersion)</Version>
		<IsPackable>true</IsPackable>
	</PropertyGroup>

	<!-- Build Options -->
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<DefineConstants>RELEASE</DefineConstants>
		<Optimize>true</Optimize>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<DefineConstants>DEBUG;PR_UNITTESTS</DefineConstants>
		<CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
	</PropertyGroup>

	<!-- Dependencies -->
	<ItemGroup>
		<ProjectReference Include="$(RylogicRoot)projects\rylogic\Rylogic.Core\Rylogic.Core.csproj" />
		<ProjectReference Include="$(RylogicRoot)projects\rylogic\Rylogic.D3D12\Rylogic.D3D12.csproj" />
		<PackageReference Include="Rylogic.Native" VersionOverride="$(RylogicNativePackageVersion)" />
		<PackageReference Include="System.Drawing.Common" Condition="'$(TargetFramework)' != 'net481'" />
		<PackageReference Include="System.Text.Json" Condition="'$(TargetFramework)' == 'net481'" />
	</ItemGroup>

	<!-- Native Runtime -->
	<Import Project="$(TargetsPath)view3d-12.targets" />
	<Import Project="$(TargetsPath)view3d-ui.targets" />

	<!-- Post Build -->
	<ItemGroup>
	  <None Update="Rylogic.Gfx.runtimeconfig.json">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	</ItemGroup>
	<Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(RunUnitTests)' != 'false'">
		<RunRylogicUnitTests TargetPath="$(TargetPath)" IsManaged="true" ProjectRoot="$(RylogicRoot)" />
	</Target>

</Project>
