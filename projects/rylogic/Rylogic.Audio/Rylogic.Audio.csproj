<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Library</OutputType>
		<RootNamespace>Rylogic.Audio</RootNamespace>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
	</PropertyGroup>

	<!-- Assembly Properties -->
	<PropertyGroup>
		<ApplicationIcon>icon_128x128.ico</ApplicationIcon>
		<Version>$(RylogicLibraryVersion)</Version>
		<IsPackable>true</IsPackable>
		<Description>Managed ownership, playback, event, and diagnostics API for the Rylogic spatial audio engine.</Description>
		<PackageTags>rylogic audio spatial-audio xaudio2 x3daudio ogg sound</PackageTags>
	</PropertyGroup>

	<!-- Build Options -->
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<DefineConstants>RELEASE</DefineConstants>
		<Optimize>true</Optimize>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<DefineConstants>DEBUG;PR_UNITTESTS</DefineConstants>
		<CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
	</PropertyGroup>

	<!-- Dependencies -->
	<ItemGroup>
		<ProjectReference Include="$(RylogicRoot)projects\rylogic\Rylogic.Core\Rylogic.Core.csproj" />
		<PackageReference Include="Rylogic.Native" VersionOverride="$(RylogicLibraryVersion)" />
		<PackageReference Include="System.Memory" Condition="'$(TargetFramework)' == 'net481'" />
	</ItemGroup>

	<!-- Native Runtime -->
	<Import Project="$(TargetsPath)audio.targets" />

	<!-- Test Data -->
	<ItemGroup>
		<None Include="testdata\fixture.ogg">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Pack>false</Pack>
		</None>
	</ItemGroup>

	<!-- Post Build -->
	<ItemGroup>
		<None Update="Rylogic.Audio.runtimeconfig.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>
	<Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(RunUnitTests)' != 'false'">
		<RunRylogicUnitTests TargetPath="$(TargetPath)" IsManaged="true" ProjectRoot="$(RylogicRoot)" />
	</Target>

</Project>
