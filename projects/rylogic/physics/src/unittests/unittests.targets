	<!-- Physics compiled tests belong to the global runner rather than the production static library. -->
	<ItemGroup Condition="'$(MSBuildProjectExtension)' == '.vcxproj'">
		<ClCompile Update="@(ClCompile->WithMetadataValue('PhysicsUnitTest', 'true'))">
			<AdditionalIncludeDirectories>
				;$(RylogicRoot)projects\rylogic\physics
				;$(RylogicRoot)projects\rylogic
				;%(AdditionalIncludeDirectories)
			</AdditionalIncludeDirectories>
		</ClCompile>
		<CompiledUnitTest Include="@(ClCompile->WithMetadataValue('PhysicsUnitTest', 'true'))" />
		<ProjectReference Include="$(RylogicRoot)projects\rylogic\physics\physics.vcxproj">
			<LinkLibraryDependencies>false</LinkLibraryDependencies>
			<UseLibraryDependencyInputs>false</UseLibraryDependencyInputs>
			<ReferenceOutputAssembly>false</ReferenceOutputAssembly>
		</ProjectReference>
		<ProjectReference Include="$(RylogicRoot)projects\rylogic\physics\physics.dll.vcxproj">
			<LinkLibraryDependencies>false</LinkLibraryDependencies>
			<UseLibraryDependencyInputs>false</UseLibraryDependencyInputs>
			<ReferenceOutputAssembly>false</ReferenceOutputAssembly>
		</ProjectReference>
	</ItemGroup>

	<!-- Imported sources remain module-owned while appearing with the runner's local sources in Solution Explorer. -->
	<ItemGroup Condition="'$(MSBuildProjectExtension)' == '.filters'">
		<Filter Include="src\physics">
			<UniqueIdentifier>{37c84008-bc16-437d-80e3-9c5542f75787}</UniqueIdentifier>
		</Filter>
	</ItemGroup>

	<ItemDefinitionGroup Condition="'$(MSBuildProjectExtension)' == '.vcxproj'">
		<Link>
			<AdditionalDependencies>
				;compute_shaders.res
				;compute_shaders_physics.res
				;d3d12.lib
				;dxguid.lib
				;%(AdditionalDependencies)
			</AdditionalDependencies>
		</Link>
	</ItemDefinitionGroup>
