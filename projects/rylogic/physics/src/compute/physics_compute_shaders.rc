// HLSL compute shader sources for runtime compilation
// Note: Don't include this rc file, add 'physics_compute_shaders.res' as a link dependency
src/compute/collide.hlsl        TEXT DISCARDABLE "src/compute/collide.hlsl"
src/compute/collision.hlsli     TEXT DISCARDABLE "src/compute/collision.hlsli"
src/compute/gjk.hlsli           TEXT DISCARDABLE "src/compute/gjk.hlsli"
src/compute/integrate.hlsl      TEXT DISCARDABLE "src/compute/integrate.hlsl"
src/compute/physics_types.hlsli TEXT DISCARDABLE "src/compute/physics_types.hlsli"
src/compute/resolve.hlsl        TEXT DISCARDABLE "src/compute/resolve.hlsl"
src/compute/selective.hlsl      TEXT DISCARDABLE "src/compute/selective.hlsl"
src/compute/sleep.hlsl          TEXT DISCARDABLE "src/compute/sleep.hlsl"
src/compute/sweep.hlsl          TEXT DISCARDABLE "src/compute/sweep.hlsl"
src/buoyancy/gpu_buoyancy.hlsl  TEXT DISCARDABLE "src/buoyancy/gpu_buoyancy.hlsl"
 
