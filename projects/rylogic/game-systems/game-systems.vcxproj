<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
  Globals
  -->
  <PropertyGroup Label="Globals">
    <ConfigurationType>StaticLibrary</ConfigurationType>
    <ProjectGuid>{B2AE012E-8FBE-456D-813D-A4EA581FA8D6}</ProjectGuid>
    <RootNamespace>GameSystems</RootNamespace>
    <ProjectName>game-systems</ProjectName>
    <TargetName>game-systems-static</TargetName>
    <ResolveNuGetPackages>false</ResolveNuGetPackages>
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
  </PropertyGroup>
  <!--
  Property Sheets
  -->
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <Import Project="$(PropsPath)build_configurations.props" />
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <Import Project="$(PropsPath)shader_build.props" />
  <Import Project="$(PropsPath)lib.props" />
  <!--
  Build options
  -->
  <ItemDefinitionGroup>
    <ClCompile>
      <PreprocessorDefinitions>
        ;%(PreprocessorDefinitions)
        ;PR_LOGGING=1
        ;PR_VIEW3D_12=1
        ;PR_RDR_RUNTIME_SHADERS=0
        ;PR_SUPPORT_D3D11_ERRORS=1
      </PreprocessorDefinitions>
      <AdditionalIncludeDirectories>
        ;$(RylogicRoot)projects\rylogic
        ;%(AdditionalIncludeDirectories)
      </AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <PreprocessorDefinitions>
        ;%(PreprocessorDefinitions)
        ;PR_DBG_RDR=1
      </PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <!--
  Shaders
  -->
  <ItemDefinitionGroup>
    <ShaderBuild>
      <ShaderType>Effect</ShaderType>
      <ShaderModel>6.6</ShaderModel>
      <AdditionalIncludeDirectories>
        ;$(ProjectDir)
        ;$(RylogicRoot)include\
        ;$(RylogicRoot)projects\rylogic\
        ;$(RylogicRoot)projects\rylogic\view3d-12\
        ;%(AdditionalIncludeDirectories)
      </AdditionalIncludeDirectories>
      <PreprocessorDefinitions>
        ;%(PreprocessorDefinitions)
        ;SHADER_BUILD
      </PreprocessorDefinitions>
    </ShaderBuild>
  </ItemDefinitionGroup>
  <!--
  Files
  -->
  <ItemGroup>
    <ClInclude Include="$(RylogicRoot)include\pr\game-systems\forward.h" />
    <ClInclude Include="$(RylogicRoot)include\pr\game-systems\sky\celestial_clock.h" />
    <ClInclude Include="$(RylogicRoot)include\pr\game-systems\sky\procedural_sky.h" />
    <ClInclude Include="$(RylogicRoot)include\pr\game-systems\sky\weather_map.h" />
    <ClCompile Include="src\sky\procedural_sky.cpp" />
    <ClCompile Include="src\sky\weather_map.cpp" />
    <None Include="src\shaders\hlsl\sky\procedural_sky_cbuf.hlsli" />
    <ShaderBuild Include="src\shaders\hlsl\sky\procedural_sky.hlsl" VertexEntryPoints="procedural_sky_vs=VSProceduralSky" PixelEntryPoints="procedural_sky_ps=PSProceduralSky" />
  </ItemGroup>
  <!--
  Dependencies
  -->
  <ItemGroup>
    <ProjectReference Include="$(RylogicRoot)projects\rylogic\view3d-12\view3d-12.vcxproj" />
  </ItemGroup>
  <!--
  Targets
  -->
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Import Project="$(TargetsPath)WinPixEventRuntime.targets" />
  <Import Project="$(TargetsPath)dxc.targets" />
</Project>
