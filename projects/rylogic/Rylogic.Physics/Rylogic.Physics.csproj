<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Library</OutputType>
		<RootNamespace>Rylogic.Physics</RootNamespace>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
	</PropertyGroup>

	<!-- Assembly Properties -->
	<PropertyGroup>
		<ApplicationIcon>icon_128x128.ico</ApplicationIcon>
		<Version>$(RylogicLibraryVersion)</Version>
		<IsPackable>true</IsPackable>
		<Description>Managed ownership, bulk stepping, snapshots, events, checkpoints, and diagnostics for the Rylogic D3D12 rigid-body physics engine.</Description>
		<PackageTags>rylogic physics simulation rigid-body d3d12</PackageTags>
	</PropertyGroup>

	<!-- Build Options -->
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<DefineConstants>RELEASE</DefineConstants>
		<Optimize>true</Optimize>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<DefineConstants>DEBUG;PR_UNITTESTS</DefineConstants>
		<CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
	</PropertyGroup>

	<!-- Dependencies -->
	<ItemGroup>
		<ProjectReference Include="$(RylogicRoot)projects\rylogic\Rylogic.Core\Rylogic.Core.csproj" />
		<ProjectReference Include="$(RylogicRoot)projects\rylogic\Rylogic.D3D12\Rylogic.D3D12.csproj" />
		<PackageReference Include="Rylogic.Native" VersionOverride="$(RylogicLibraryVersion)" />
		<PackageReference Include="System.Memory" Condition="'$(TargetFramework)' == 'net481'" />
	</ItemGroup>

	<!-- Native Runtime -->
	<Import Project="$(TargetsPath)physics.targets" />

	<!-- Post Build -->
	<ItemGroup>
		<None Update="Rylogic.Physics.runtimeconfig.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>
	<Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(RunUnitTests)' != 'false'">
		<RunRylogicUnitTests TargetPath="$(TargetPath)" IsManaged="true" ProjectRoot="$(RylogicRoot)" />
	</Target>

</Project>
