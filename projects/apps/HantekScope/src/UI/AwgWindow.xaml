<Window
	x:Class="HantekScope.UI.AwgWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="Waveform Generator"
	Width="300"
	Height="260"
	ResizeMode="NoResize"
	ShowInTaskbar="False"
	WindowStartupLocation="CenterOwner"
	Background="#1E1E1E"
	TextElement.Foreground="#DDDDDD"
	>
	<Grid Margin="12">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="Auto" />
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!-- Waveform shape -->
		<TextBlock Grid.Row="0" Grid.Column="0" Text="Waveform" VerticalAlignment="Center" Margin="0,0,8,8" />
		<ComboBox
			Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
			x:Name="m_cmb_waveform"
			Margin="0,0,0,8"
			SelectionChanged="OnWaveformChanged"
			/>

		<!-- Frequency value + unit -->
		<TextBlock Grid.Row="1" Grid.Column="0" Text="Frequency" VerticalAlignment="Center" Margin="0,0,8,8" />
		<TextBox
			Grid.Row="1" Grid.Column="1"
			x:Name="m_txt_frequency"
			Margin="0,0,8,8"
			VerticalContentAlignment="Center"
			KeyDown="OnFrequencyKeyDown"
			LostFocus="OnFrequencyCommitted"
			/>
		<ComboBox
			Grid.Row="1" Grid.Column="2"
			x:Name="m_cmb_freq_unit"
			Width="64"
			Margin="0,0,0,8"
			SelectionChanged="OnFrequencyUnitChanged"
			/>

		<!-- Amplitude (Vpp) -->
		<TextBlock Grid.Row="2" Grid.Column="0" Text="Amplitude" VerticalAlignment="Center" Margin="0,0,8,8" />
		<TextBox
			Grid.Row="2" Grid.Column="1"
			x:Name="m_txt_amplitude"
			Margin="0,0,8,8"
			VerticalContentAlignment="Center"
			ToolTip="Peak-to-peak volts (0–2.5 Vpp). A high-impedance load such as the scope input reads about twice this value."
			KeyDown="OnAmplitudeKeyDown"
			LostFocus="OnAmplitudeCommitted"
			/>
		<TextBlock Grid.Row="2" Grid.Column="2" Text="Vpp" VerticalAlignment="Center" Margin="0,0,0,8" />

		<!-- Duty cycle (square only) -->
		<TextBlock Grid.Row="3" Grid.Column="0" Text="Duty" VerticalAlignment="Center" Margin="0,0,8,8" />
		<Slider
			Grid.Row="3" Grid.Column="1"
			x:Name="m_sld_duty"
			Minimum="10"
			Maximum="89"
			TickFrequency="1"
			IsSnapToTickEnabled="True"
			VerticalAlignment="Center"
			Margin="0,0,8,8"
			ValueChanged="OnDutyChanged"
			/>
		<TextBlock Grid.Row="3" Grid.Column="2" x:Name="m_lbl_duty" Text="50 %" VerticalAlignment="Center" Margin="0,0,0,8" />

		<TextBlock
			Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
			x:Name="m_lbl_hint"
			VerticalAlignment="Bottom"
			TextWrapping="Wrap"
			FontSize="11"
			Foreground="#909090"
			Text="Changes apply to the scope's generator immediately."
			/>
	</Grid>
</Window>
