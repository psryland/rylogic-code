<Window
	x:Class="HantekScope.UI.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:gui="clr-namespace:Rylogic.Gui.WPF;assembly=Rylogic.Gfx"
	Title="Hantek 2D42 Scope"
	Height="600"
	Width="1000"
	Background="#0b0f14"
	>
	<DockPanel>

		<!-- Toolbar -->
		<ToolBarTray DockPanel.Dock="Top" Background="#11161d">
			<ToolBar Background="#11161d">
				<Button x:Name="m_btn_run" Content="Run" MinWidth="60" Click="OnRunStop" />
				<ToggleButton x:Name="m_btn_follow" Content="Follow" MinWidth="60" IsChecked="True" />
				<Separator />
				<TextBlock x:Name="m_status" Foreground="#9fb3c8" VerticalAlignment="Center" Margin="8,0" Text="Disconnected" />
			</ToolBar>
		</ToolBarTray>

		<!-- Live trace -->
		<gui:ChartControl
			x:Name="m_chart"
			Title="Hantek 2D42"
			XLabel="time (ms)"
			YLabel="volts"
			/>

	</DockPanel>
</Window>
