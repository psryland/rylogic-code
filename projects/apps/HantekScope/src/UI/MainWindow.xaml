<Window
	x:Class="HantekScope.UI.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:gui="clr-namespace:Rylogic.Gui.WPF;assembly=Rylogic.Gfx"
	Title="Hantek 2D42 Scope"
	Height="600"
	Width="1000"
	>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!-- Main menu -->
		<Menu Grid.Row="0">
			<MenuItem Header="_File">
				<MenuItem Header="E_xit" Click="OnExit" />
			</MenuItem>
		</Menu>

		<!-- Toolbar: run/stop -->
		<ToolBarTray Grid.Row="1">
			<ToolBar>
				<Button x:Name="m_btn_run" Content="Run" MinWidth="60" Click="OnRunStop" />
			</ToolBar>
		</ToolBarTray>

		<!-- Live trace; small margin so it isn't hard up against the window edges. -->
		<gui:ChartControl
			Grid.Row="2"
			x:Name="m_chart"
			Margin="8,6"
			XLabel="time (ms)"
			YLabel="volts"
			/>

		<!-- Status bar: connection status, identity and current acquisition resolution -->
		<StatusBar Grid.Row="3">
			<StatusBarItem>
				<StackPanel Orientation="Horizontal">
					<Ellipse x:Name="m_conn_led" Width="10" Height="10" Fill="#7f8c8d" VerticalAlignment="Center" Margin="0,0,4,0" />
					<TextBlock x:Name="m_conn_status" VerticalAlignment="Center" Text="Disconnected" />
				</StackPanel>
			</StatusBarItem>
			<Separator />
			<StatusBarItem>
				<TextBlock x:Name="m_status_identity" Text="&#x2014;" />
			</StatusBarItem>
			<Separator />
			<StatusBarItem>
				<TextBlock x:Name="m_status_config" Text="" />
			</StatusBarItem>
			<Separator />
			<StatusBarItem>
				<TextBlock x:Name="m_status_mode" Text="Framed" />
			</StatusBarItem>
		</StatusBar>

	</Grid>
</Window>
