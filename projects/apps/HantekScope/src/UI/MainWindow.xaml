<Window
	x:Class="HantekScope.UI.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:gui="clr-namespace:Rylogic.Gui.WPF;assembly=Rylogic.Gfx"
	Title="Hantek 2D42 Scope"
	Height="600"
	Width="1000"
	Background="#0b0f14"
	>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!-- Main menu -->
		<Menu Grid.Row="0" Background="#11161d" Foreground="#cdd9e5">
			<MenuItem Header="_File" Foreground="#11161d">
				<MenuItem Header="E_xit" Click="OnExit" />
			</MenuItem>
		</Menu>

		<!-- Toolbar: run/stop and live connection status -->
		<ToolBarTray Grid.Row="1" Background="#11161d">
			<ToolBar Background="#11161d">
				<Button x:Name="m_btn_run" Content="Run" MinWidth="60" Click="OnRunStop" />
				<Separator />
				<Ellipse x:Name="m_conn_led" Width="10" Height="10" Fill="#7f8c8d" VerticalAlignment="Center" Margin="4,0" />
				<TextBlock x:Name="m_conn_status" Foreground="#9fb3c8" VerticalAlignment="Center" Margin="4,0" Text="Disconnected" />
			</ToolBar>
		</ToolBarTray>

		<!-- Live trace -->
		<gui:ChartControl
			Grid.Row="2"
			x:Name="m_chart"
			Title="Hantek 2D42"
			XLabel="time (ms)"
			YLabel="volts"
			/>

		<!-- Status bar: identity and current acquisition resolution -->
		<StatusBar Grid.Row="3" Background="#11161d" Foreground="#9fb3c8">
			<StatusBarItem>
				<TextBlock x:Name="m_status_identity" Text="—" />
			</StatusBarItem>
			<Separator />
			<StatusBarItem>
				<TextBlock x:Name="m_status_config" Text="" />
			</StatusBarItem>
			<Separator />
			<StatusBarItem>
				<TextBlock x:Name="m_status_mode" Text="Framed" />
			</StatusBarItem>
		</StatusBar>

	</Grid>
</Window>
