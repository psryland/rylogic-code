<UserControl x:Class="Rylogic.LDrawVisualiser.VisualizerToolWindowControl"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:vs_shell="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
	xmlns:vs_ui="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
	xmlns:local="clr-namespace:Rylogic.LDrawVisualiser"
	Background="{DynamicResource {x:Static vs_shell:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
	Foreground="{DynamicResource {x:Static vs_shell:EnvironmentColors.ToolWindowTextBrushKey}}">

	<UserControl.Resources>

		<!-- Transparent flat button style for script item actions -->
		<Style x:Key="FlatButtonStyle" TargetType="Button">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="3,1"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Foreground" Value="{DynamicResource {x:Static vs_shell:EnvironmentColors.ToolWindowTextBrushKey}}"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="border"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							Padding="{TemplateBinding Padding}"
							CornerRadius="2">
							<ContentPresenter
								HorizontalAlignment="Center"
								VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="border" Property="Background" Value="#30FFFFFF"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="border" Property="Background" Value="#50FFFFFF"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- Smaller flat button for the inline rename pencil -->
		<Style x:Key="InlineFlatButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonStyle}">
			<Setter Property="Padding" Value="2,0"/>
			<Setter Property="FontSize" Value="10"/>
			<Setter Property="Opacity" Value="0.5"/>
			<Style.Triggers>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter Property="Opacity" Value="1.0"/>
				</Trigger>
			</Style.Triggers>
		</Style>

	</UserControl.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<!-- Toolbar -->
			<RowDefinition Height="Auto"/>
			<!-- Scripts list -->
			<RowDefinition Height="*"/>
			<!-- Error panel (auto-hides) -->
			<RowDefinition Height="Auto"/>
			<!-- Status bar -->
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Toolbar -->
		<WrapPanel Grid.Row="0" Margin="4">
			<Button Content="📄 New Script" Click="OnNewScript" Margin="0,0,4,2" Padding="6,2"/>
			<Button x:Name="m_connect_btn" Content="Connect" Click="OnConnectClick" Width="70" Margin="0,0,4,2" Padding="6,2"/>
			<Ellipse x:Name="m_status_indicator" Width="12" Height="12" Fill="Gray" VerticalAlignment="Center" Margin="4,0,8,2"
				ToolTip="Disconnected"/>
			<Button x:Name="m_refresh_btn" Content="⟳ Refresh" Click="OnRefreshClick" Margin="0,0,4,2" Padding="6,2"/>
			<CheckBox x:Name="m_auto_refresh_check" Content="Auto-refresh on break" VerticalAlignment="Center" Margin="8,0,0,2"
				IsChecked="True"
				Foreground="{DynamicResource {x:Static vs_shell:EnvironmentColors.ToolWindowTextBrushKey}}"/>
		</WrapPanel>

		<!-- Scripts List -->
		<Border Grid.Row="1"
			BorderBrush="{DynamicResource {x:Static vs_shell:EnvironmentColors.ToolWindowBorderBrushKey}}"
			BorderThickness="0,1,0,0">
			<ListBox x:Name="m_scripts_list" 
				Background="{DynamicResource {x:Static vs_shell:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
				Foreground="{DynamicResource {x:Static vs_shell:EnvironmentColors.ToolWindowTextBrushKey}}"
				BorderThickness="0"
				MouseDoubleClick="OnScriptDoubleClick"
				SelectionChanged="OnScriptSelectionChanged"
				HorizontalContentAlignment="Stretch">
				<ListBox.ItemContainerStyle>
					<Style TargetType="ListBoxItem">
						<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
						<Setter Property="ToolTip" Value="{Binding FilePath}"/>
					</Style>
				</ListBox.ItemContainerStyle>
				<ListBox.ItemTemplate>
					<DataTemplate>
						<Grid Margin="2,1">
							<Grid.ColumnDefinitions>
								<!-- Script icon -->
								<ColumnDefinition Width="Auto"/>
								<!-- Script name + rename pencil -->
								<ColumnDefinition Width="*"/>
								<!-- Action buttons -->
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>

							<!-- Script icon -->
							<TextBlock Grid.Column="0"
								Text="📝"
								FontSize="14"
								VerticalAlignment="Center"
								Margin="0,0,6,0"/>

							<!-- Script name with inline rename pencil -->
							<StackPanel Grid.Column="1"
								Orientation="Horizontal"
								VerticalAlignment="Center">
								<TextBlock
									Text="{Binding Name}"
									FontSize="13"
									VerticalAlignment="Center">
									<TextBlock.Style>
										<!-- Default: semi-bold, theme foreground.
										     Active script (currently shown in LDraw): bold + green.
										     Triggered on the bound ScriptInfo.IsActive property. -->
										<Style TargetType="TextBlock">
											<Setter Property="FontWeight" Value="SemiBold"/>
											<Style.Triggers>
												<DataTrigger Binding="{Binding IsActive}" Value="True">
													<Setter Property="FontWeight" Value="Bold"/>
													<Setter Property="Foreground" Value="#4EC9B0"/>
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</TextBlock.Style>
								</TextBlock>
								<Button
									Content="✏"
									ToolTip="Rename this script"
									Tag="{Binding}"
									Click="OnRenameScript"
									Style="{StaticResource InlineFlatButtonStyle}"
									VerticalAlignment="Center"
									Margin="4,0,0,0"/>
							</StackPanel>

							<!-- Action buttons -->
							<StackPanel Grid.Column="2"
								Orientation="Horizontal"
								VerticalAlignment="Center">
								<Button
									Content="📂"
									ToolTip="Reveal in Explorer"
									Tag="{Binding}"
									Click="OnRevealScript"
									Style="{StaticResource FlatButtonStyle}"
									FontSize="13"
									Margin="2,0"/>
								<Button
									Content="▶"
									ToolTip="Run this script"
									Tag="{Binding}"
									Click="OnRunScript"
									Style="{StaticResource FlatButtonStyle}"
									Foreground="#4EC9B0"
									FontSize="13"
									Margin="2,0"/>
								<Button
									Content="✕"
									ToolTip="Delete this script"
									Tag="{Binding}"
									Click="OnDeleteScript"
									Style="{StaticResource FlatButtonStyle}"
									Foreground="#E05561"
									FontSize="13"
									Margin="2,0"/>
							</StackPanel>
						</Grid>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		</Border>

		<!-- Error Panel (auto-hides when empty) -->
		<Border Grid.Row="2"
			x:Name="m_error_panel"
			Visibility="Collapsed"
			BorderBrush="{DynamicResource {x:Static vs_shell:EnvironmentColors.ToolWindowValidationErrorBorderBrushKey}}"
			BorderThickness="0,2,0,0"
			Background="{DynamicResource {x:Static vs_shell:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
			MinHeight="40"
			MaxHeight="160">
			<ScrollViewer
				VerticalScrollBarVisibility="Auto"
				HorizontalScrollBarVisibility="Disabled">
				<TextBlock x:Name="m_error_text"
					Foreground="{DynamicResource {x:Static vs_shell:EnvironmentColors.ToolWindowValidationErrorTextBrushKey}}"
					FontFamily="Consolas"
					FontSize="12"
					TextWrapping="Wrap"
					Margin="6,3"/>
			</ScrollViewer>
		</Border>

		<!-- Status Bar -->
		<Border Grid.Row="3" BorderBrush="{DynamicResource {x:Static vs_shell:EnvironmentColors.ToolWindowBorderBrushKey}}" BorderThickness="0,1,0,0" Padding="4,2">
			<TextBlock x:Name="m_status_text" Text="Ready" FontSize="11"
				Foreground="{DynamicResource {x:Static vs_shell:EnvironmentColors.ToolWindowTextBrushKey}}"/>
		</Border>
	</Grid>
</UserControl>
