<UserControl x:Class="Rylogic.LDrawVisualiser.VisualizerToolWindowControl"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
	Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
	Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">

	<Grid>
		<Grid.RowDefinitions>
			<!-- Connection bar -->
			<RowDefinition Height="Auto"/>
			<!-- Script editor -->
			<RowDefinition Height="*"/>
			<!-- Error panel (auto-hides) -->
			<RowDefinition Height="Auto"/>
			<!-- Status bar -->
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Connection Bar -->
		<StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4">
			<TextBlock Text="Address:" VerticalAlignment="Center" Margin="0,0,4,0"/>
			<TextBox x:Name="m_address_box" Text="localhost:1976" Width="160" VerticalAlignment="Center" Margin="0,0,4,0"/>
			<Button x:Name="m_connect_btn" Content="Connect" Click="OnConnectClick" Width="70" VerticalAlignment="Center" Margin="0,0,4,0"/>
			<Ellipse x:Name="m_status_indicator" Width="12" Height="12" Fill="Gray" VerticalAlignment="Center" Margin="4,0,8,0"
				ToolTip="Disconnected"/>
			<Button x:Name="m_refresh_btn" Content="⟳ Refresh" Click="OnRefreshClick" Width="80" VerticalAlignment="Center" Margin="0,0,4,0"/>
			<CheckBox x:Name="m_auto_refresh_check" Content="Auto-refresh on break" VerticalAlignment="Center" Margin="8,0,0,0"
				IsChecked="True"/>
		</StackPanel>

		<!-- Script Editor -->
		<avalonedit:TextEditor
			Grid.Row="1"
			x:Name="m_script_editor"
			FontFamily="Consolas"
			FontSize="13"
			SyntaxHighlighting="C#"
			ShowLineNumbers="True"
			HorizontalScrollBarVisibility="Auto"
			VerticalScrollBarVisibility="Auto"
			Margin="4,0,4,0"/>

		<!-- Error Panel (auto-hides when empty) -->
		<Border Grid.Row="2" x:Name="m_error_panel" Visibility="Collapsed"
			BorderBrush="DarkRed" BorderThickness="0,1,0,0" Background="#FFF8F0F0" MaxHeight="120">
			<ScrollViewer VerticalScrollBarVisibility="Auto">
				<ItemsControl x:Name="m_error_list">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<TextBlock Text="{Binding}" Foreground="DarkRed" FontFamily="Consolas" FontSize="11" Margin="4,1"/>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</ScrollViewer>
		</Border>

		<!-- Status Bar -->
		<Border Grid.Row="3" BorderBrush="LightGray" BorderThickness="0,1,0,0" Padding="4,2">
			<TextBlock x:Name="m_status_text" Text="Ready" FontSize="11"/>
		</Border>
	</Grid>
</UserControl>
