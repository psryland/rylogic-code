<UserControl x:Class="Rylogic.LDrawVisualiser.LDrawVisualiserOptionsUI"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Padding="8">

	<StackPanel>
		<!-- Default Script Text -->
		<TextBlock Text="Default Script Text:" FontWeight="SemiBold" Margin="0,0,0,4"/>
		<TextBlock Text="The initial script shown when the LDraw Visualiser tool window opens." FontSize="11" Foreground="Gray" Margin="0,0,0,4"/>
		<TextBox x:Name="m_script_text"
			AcceptsReturn="True"
			AcceptsTab="True"
			TextWrapping="Wrap"
			FontFamily="Consolas"
			FontSize="12"
			MinHeight="120"
			MaxHeight="300"
			VerticalScrollBarVisibility="Auto"
			Margin="0,0,0,16"/>

		<!-- Default Address -->
		<TextBlock Text="Default Address:" FontWeight="SemiBold" Margin="0,0,0,4"/>
		<TextBlock Text="The default host:port for LDraw streaming (e.g. localhost:1976)." FontSize="11" Foreground="Gray" Margin="0,0,0,4"/>
		<TextBox x:Name="m_address_text" Width="250" HorizontalAlignment="Left" Margin="0,0,0,16"/>

		<!-- Default Auto-Refresh -->
		<CheckBox x:Name="m_auto_refresh_check" Content="Auto-refresh on break (default)" Margin="0,0,0,16"/>
	</StackPanel>
</UserControl>
