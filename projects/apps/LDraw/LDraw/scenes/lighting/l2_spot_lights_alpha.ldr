// L2: 8 spot lights plus a directional light, with transparent objects.
*Plane floor FFA0A0A0
{
	*Data {20 20}
	*AxisId {+3}
}
*LightSource sun FF404040
{
	*Style {Directional}
	*Diffuse {FF404040}
	*Specular {FF404040 64}
	*o2w {*pos {-5 -8 10} *LookAt {0 0 0}}
}
*LightSource spot0 FFFF4040
{
	*Style {Spot}
	*Diffuse {FFFF4040}
	*Specular {FF404040 64}
	*Range {15 0}
	*Cone {20 35}
	*o2w {*pos {6 0 5} *LookAt {2.5 0 0}}
}
*Sphere marker0 FFFF4040 { *Data {0.05} *o2w {*pos {6 0 5}} }
