<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

	<!-- Globals -->
	<PropertyGroup Label="Globals">
		<ConfigurationType>Application</ConfigurationType>
		<ProjectGuid>{029199FD-C815-46E4-ADAF-5F51AFFF5CA1}</ProjectGuid>
		<ProjectName>view3d-ui-tests</ProjectName>
		<RootNamespace>view3d_ui_tests</RootNamespace>
	</PropertyGroup>

	<!-- Property Sheets -->
	<Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
	<Import Project="$(PropsPath)build_configurations.props" />
	<Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
	<Import Project="$(PropsPath)app.props" />

	<!-- Build options -->
	<ItemDefinitionGroup>
		<ClCompile>
			<EnableModules>false</EnableModules>
			<LanguageStandard>stdcpplatest</LanguageStandard>
			<PreprocessorDefinitions>
				;PR_UNITTESTS=1
				;%(PreprocessorDefinitions)
			</PreprocessorDefinitions>
			<AdditionalIncludeDirectories>
				;$(ProjectDir)
				;$(RylogicRoot)include
				;$(RylogicRoot)projects\rylogic\view3d-ui\src
				;$(RylogicRoot)projects\rylogic\view3d-ui\dll
				;%(AdditionalIncludeDirectories)
			</AdditionalIncludeDirectories>
		</ClCompile>
		<Link>
			<SubSystem>Console</SubSystem>
			<!-- root.props sets LinkLibraryDependencies=false repo-wide, so ProjectReference alone
			     does not link a referenced static library's output; view3d-ui-static.lib (built by
			     view3d-ui.vcxproj) must be named explicitly here, matching how view3d-ui.dll.vcxproj
			     itself links the same static library. -->
			<AdditionalDependencies>
				;view3d-ui-static.lib
				;%(AdditionalDependencies)
			</AdditionalDependencies>
			<AdditionalLibraryDirectories>
				;$(RylogicRoot)obj\view3d-ui\$(Platform)\$(Configuration)
				;%(AdditionalLibraryDirectories)
			</AdditionalLibraryDirectories>
		</Link>
	</ItemDefinitionGroup>

	<!-- Files -->
	<ItemGroup>
		<ClInclude Include="src\test_support.h" />
		<ClCompile Include="src\main.cpp" />
		<ClCompile Include="src\tests_m0_abi_lifetime.cpp" />
		<ClCompile Include="src\tests_m1_transactions.cpp" />
		<ClCompile Include="src\tests_m1_events.cpp" />
		<ClCompile Include="src\tests_m2_layout.cpp" />
		<ClCompile Include="src\tests_m2_input_focus.cpp" />
		<ClCompile Include="src\tests_m2_semantics.cpp" />
		<ClCompile Include="src\tests_m3_glyph_cache.cpp" />
		<ClCompile Include="src\tests_m3_text_shaper.cpp" />
		<ClCompile Include="src\tests_m3_draw_packet.cpp" />
		<ClCompile Include="src\tests_m3_renderer.cpp" />
		<ClCompile Include="src\tests_m3_input_activation.cpp" />
		<ClCompile Include="src\tests_m3_bridge_and_lifecycle.cpp" />
		<ClCompile Include="src\tests_m3_text_reconciliation.cpp" />
		<ClCompile Include="src\tests_m5_hardening.cpp" />
    <ClCompile Include="src\tests_m8_world_roots.cpp" />
		<ClCompile Include="src\tests_m9_text_unicode.cpp" />
		<ClCompile Include="src\tests_m9_text_layout.cpp" />
		<ClCompile Include="src\tests_m9_text_editing.cpp" />
		<ClCompile Include="src\tests_m9_win32_input.cpp" />
		<ClCompile Include="src\tests_m9_abi.cpp" />
		<ClCompile Include="src\tests_m9_corrections.cpp" />
		<ClCompile Include="src\tests_m10_uia.cpp" />
	</ItemGroup>

	<!-- Dependencies: view3d-ui.h loads view3d-ui.dll dynamically at runtime (GetProcAddress), so
	     there is no import library to link against; the DLL project reference only orders the
	     build, and DependencyLink copies the built DLL next to this test's own executable so
	     win32::LoadDll's default relative search path finds it. The M3 white-box test files below
	     additionally link view3d-ui.vcxproj's static library directly (view3d-ui-static.lib) to
	     reach UiEngine/DrawPacket/GlyphCache/TextShaper, which are internal, non-ABI headers never
	     exposed through the dynamic facade; this mirrors how view3d-ui.dll.vcxproj itself links
	     the same static library, and produces its own separate, non-conflicting object code
	     inside this test executable (the DLL never exports these symbols, so there is no ODR risk
	     between the two binaries). tests_m3_renderer.cpp additionally compiles dll\renderer.cpp
	     directly into this project for the same white-box reason; renderer.cpp only depends on
	     GlyphCache/TextShaper (supplied by the static library link above) and the private view3d-
	     12 UI host bridge header, so it needs no other file from view3d-ui.dll.vcxproj. -->
	<ItemGroup>
		<ProjectReference Include="$(RylogicRoot)projects\rylogic\view3d-ui\view3d-ui.dll.vcxproj" />
		<ProjectReference Include="$(RylogicRoot)projects\rylogic\view3d-ui\view3d-ui.vcxproj" />
	</ItemGroup>
	<ItemGroup>
		<ClInclude Include="$(RylogicRoot)projects\rylogic\view3d-ui\dll\renderer.h" />
		<ClCompile Include="$(RylogicRoot)projects\rylogic\view3d-ui\dll\renderer.cpp" />
	</ItemGroup>
	<ItemGroup>
		<DependencyLink Include="$(RylogicRoot)lib\$(Platform)\$(Configuration)\view3d-ui.dll" />
	</ItemGroup>

	<!-- Targets -->
	<Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
