<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<PropertyGroup Label="Globals">
		<ConfigurationType>Application</ConfigurationType>
		<ProjectGuid>{674AFD15-D7C5-456A-8B80-5E74017E6840}</ProjectGuid>
		<ProjectName>view3d-fade-tests</ProjectName>
		<RylogicGeneratePackageOnBuild>false</RylogicGeneratePackageOnBuild>
	</PropertyGroup>
	<Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
	<Import Project="$(PropsPath)build_configurations.props" />
	<Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
	<Import Project="$(PropsPath)app.props" />
	<Import Project="$(PropsPath)shader_build.props" />
	<ItemDefinitionGroup>
		<ClCompile>
			<EnableModules>false</EnableModules>
			<AdditionalIncludeDirectories>$(RylogicRoot)include;$(RylogicRoot)projects\rylogic;$(ProjectDir)src\shaders\hlsl\compiled\$(Configuration);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
		</ClCompile>
		<Link>
			<SubSystem>Console</SubSystem>
			<AdditionalDependencies>$(RylogicRoot)obj\view3d-12.dll\$(Platform)\$(Configuration)\view3d-12.imp;$(RylogicRoot)obj\view3d-12\$(Platform)\$(Configuration)\view3d-12-static.lib;$(RylogicRoot)obj\compute\$(Platform)\$(Configuration)\compute-static.lib;d3d12.lib;%(AdditionalDependencies)</AdditionalDependencies>
		</Link>
	</ItemDefinitionGroup>
	<ItemGroup>
		<ClInclude Include="src\forward.h" />
		<ClCompile Include="src\main.cpp" />
		<ShaderBuild Include="src\shaders\hlsl\fade_vertex.hlsl" VertexEntryPoints="fade_vertex=VSMain" PixelEntryPoints="unsupported_pixel=PSMain" />
		<ShaderBuild Include="src\shaders\hlsl\procedural_vertex_forward.hlsl" VertexEntryPoints="procedural_vertex_forward=VSMain" />
		<ShaderBuild Include="src\shaders\hlsl\procedural_vertex_raycast.hlsl" VertexEntryPoints="procedural_vertex_raycast=VSMain" />
		<ShaderBuild Include="src\shaders\hlsl\procedural_vertex_shadow.hlsl" VertexEntryPoints="procedural_vertex_shadow=VSMain" />
		<ProjectReference Include="$(RylogicRoot)projects\rylogic\view3d-12\view3d-12.dll.vcxproj" />
	</ItemGroup>
	<Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
	<Import Project="$(TargetsPath)WinPixEventRuntime.targets" />
	<Import Project="$(SDKPath)openxr/openxr.targets" />
	<!-- The fixture must exercise the freshly built renderer, not the separately deployed lib directory. -->
	<Target Name="CopyFixtureRenderer" AfterTargets="Build">
		<Copy SourceFiles="$(RylogicRoot)obj\view3d-12.dll\$(Platform)\$(Configuration)\view3d-12.dll" DestinationFolder="$(TargetDir)" />
	</Target>
</Project>
