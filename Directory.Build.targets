<Project>

	<!--
	CodeSync: Synchronise PR_CODE_SYNC blocks across the codebase.
	Runs once per build session. The tool uses a named mutex for parallel-build
	safety and a stamp file to avoid re-running within the same build session.
	-->
	<PropertyGroup>
		<CodeSyncStamp>$(RylogicRoot)obj\.codesync.stamp</CodeSyncStamp>
		<CodeSyncTool>$(ToolsPath)code_sync/code_sync.exe</CodeSyncTool>
		<CodeSyncTabSize>4</CodeSyncTabSize>
	</PropertyGroup>
	<PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.vcxproj'">
		<CodeSyncHookTarget>BuildGenerateSources</CodeSyncHookTarget>
	</PropertyGroup>
	<PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
		<CodeSyncHookTarget>BeforeBuild</CodeSyncHookTarget>
	</PropertyGroup>
	<Target Name="CodeSyncTarget" BeforeTargets="$(CodeSyncHookTarget)" Condition="'$(CodeSyncHookTarget)' != '' AND '$(RunCodeSync)' != 'false'">
		<!-- Run CodeSync. The tool handles serialisation and stamp checking internally. -->
		<Exec
			Command="$(CodeSyncTool) &quot;$(RylogicRoot)projects&quot; &quot;$(RylogicRoot)include&quot; --tab-size $(CodeSyncTabSize) --stamp &quot;$(CodeSyncStamp)&quot;"
			ConsoleToMSBuild="true"
			IgnoreExitCode="false"
			StandardOutputImportance="High" />
	</Target>

	<!--
	Run unit-test entry points from MSBuild without dotnet-script. Managed assemblies are still hosted out-of-process because
	Visual Studio's MSBuild process cannot safely load modern .NET/WPF target-framework assemblies in-process. -->
	<UsingTask TaskName="RunRylogicUnitTests" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
		<Task>
			<Reference Include="$(MSBuildToolsPath)\Microsoft.Build.Framework.dll" />
			<Reference Include="$(MSBuildToolsPath)\Microsoft.Build.Utilities.Core.dll" />
			<Code Type="Class" Language="cs" Source="$(MSBuildThisFileDirectory)build\tasks\RunRylogicUnitTests.cs" />
		</Task>
	</UsingTask>

	<ItemGroup Condition="'$(MSBuildProjectName)' == 'unittests'">
		<NativeUnitTestRun Include="-flags:Quick" />
	</ItemGroup>
	<Target Name="RunUnitTests" AfterTargets="Build" Condition="'$(MSBuildProjectName)' == 'unittests' AND '$(RunUnitTests)' != 'false'">
		<RunRylogicUnitTests TargetPath="$(TargetPath)" IsManaged="false" ProjectRoot="$(RylogicRoot)" Arguments="%(NativeUnitTestRun.Identity)" />
	</Target>

	<!--
	Auto-pack library assemblies to the config-specific staging feed, then sync the canonical local feed and global cache.
	This must be in .targets (not .props) so that IsPackable from individual .csproj files is available.
	Skipped in CI where packaging is not needed and cache-sync scripts may not be available. -->
	<PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.csproj' AND '$(IsPackable)' == 'true' AND '$(GITHUB_ACTIONS)' != 'true' AND '$(RylogicGeneratePackageOnBuild)' != 'false'">
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageOutputPath>$(RylogicRoot)lib\packages\$(Configuration.ToLowerInvariant())\</PackageOutputPath>
		<_RylogicNuGetPackage>true</_RylogicNuGetPackage>
	</PropertyGroup>
	<ItemGroup Condition="'$(_RylogicNuGetPackage)' == 'true'">
		<None Include="$(MSBuildProjectDirectory)\Readme.md" Pack="true" PackagePath="\" Condition="Exists('$(MSBuildProjectDirectory)\Readme.md')" />
	</ItemGroup>

	<!-- Sync locally built packages in-process so Visual Studio consumers see the latest package without starting dotnet-script. -->
	<UsingTask TaskName="SyncNuGetPackageOutputs" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll" Condition="'$(MSBuildProjectExtension)' == '.csproj'">
		<Task>
			<Reference Include="$(MSBuildToolsPath)\Microsoft.Build.Framework.dll" />
			<Reference Include="$(MSBuildToolsPath)\Microsoft.Build.Utilities.Core.dll" />
			<Code Type="Class" Language="cs" Source="$(MSBuildThisFileDirectory)build\tasks\InstallNuGetCache.cs" />
		</Task>
	</UsingTask>

	<!--
	Refresh the canonical local feed and global NuGet cache for the current version after packing so consumers always get the latest build.
	Overwrites destination package files in-place and removes stale cache payload entries without deleting the package root.
	Uses a stamp file per package to run only once across TFMs in multi-targeting builds. -->
	<Target Name="SyncNuGetPackageOutputs" AfterTargets="Pack" Condition="'$(_RylogicNuGetPackage)' == 'true'">
		<PropertyGroup>
			<_PkgIdLower>$(PackageId.ToLowerInvariant())</_PkgIdLower>
			<_NuGetCacheDir>$(UserProfile)\.nuget\packages\$(_PkgIdLower)\$(Version)</_NuGetCacheDir>
			<_NuGetFeedPath>$(RylogicRoot)lib\packages\$(PackageId).$(Version).nupkg</_NuGetFeedPath>
			<_NuPkgPath>$([System.IO.Path]::Combine('$(PackageOutputPath)', '$(PackageId).$(Version).nupkg'))</_NuPkgPath>
			<_NuPkgCacheName>$(_PkgIdLower).$(Version).nupkg</_NuPkgCacheName>
			<_NuPkgCachePath>$([System.IO.Path]::Combine('$(_NuGetCacheDir)', '$(_NuPkgCacheName)'))</_NuPkgCachePath>
			<_SyncStamp>$(RylogicRoot)obj\.sync.$(_PkgIdLower).stamp</_SyncStamp>
			<_NeedsSync>false</_NeedsSync>
			<_NeedsSync Condition="!Exists('$(_SyncStamp)')">true</_NeedsSync>
			<_NeedsSync Condition="'$(_NeedsSync)' == 'false' AND !Exists('$(_NuGetFeedPath)')">true</_NeedsSync>
			<_NeedsSync Condition="'$(_NeedsSync)' == 'false' AND !Exists('$(_NuPkgCachePath)')">true</_NeedsSync>
			<_NeedsSync Condition="'$(_NeedsSync)' == 'false' AND $([System.IO.File]::GetLastWriteTime('$(_NuPkgPath)').Ticks) &gt; $([System.IO.File]::GetLastWriteTime('$(_SyncStamp)').Ticks)">true</_NeedsSync>

			<_NuGetPackageSynced>false</_NuGetPackageSynced>
		</PropertyGroup>

		<!--
		Serialise concurrent writers and retry transient file locks held by Visual Studio build processes.
		Leave the stamp unchanged after a persistent failure so the next build retries the installation. -->
		<SyncNuGetPackageOutputs
			Condition="'$(_NeedsSync)' == 'true'"
			NuPkgPath="$(_NuPkgPath)"
			FeedPkgPath="$(_NuGetFeedPath)"
			CacheDir="$(_NuGetCacheDir)"
			NuPkgName="$(_NuPkgCacheName)"
			RetryTimeoutMilliseconds="15000">
			<Output TaskParameter="Synced" PropertyName="_NuGetPackageSynced" />
		</SyncNuGetPackageOutputs>
		<Touch Condition="'$(_NuGetPackageSynced)' == 'true'" Files="$(_SyncStamp)" AlwaysCreate="true" />
		<Message Condition="'$(_NuGetPackageSynced)' == 'true'" Text="Synced $(_PkgIdLower) $(Version) into the local feed and NuGet cache" Importance="high" />
	</Target>

</Project>
