<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

	<PropertyGroup>
		<PixPackagePath>$(NuGetPackageRoot)\WinPixEventRuntime\1.0.240308001\</PixPackagePath>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="WinPixEventRuntime" />
		<PackageVersion Include="WinPixEventRuntime" Version="1.0.240308001" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="$(PixPackagePath)bin\x64\WinPixEventRuntime.dll">
			<Link>lib\x64\WinPixEventRuntime.dll</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<BuildArtifacts Include="$(PixPackagePath)bin\x64\WinPixEventRuntime.dll" />
	</ItemGroup>
	
	<ItemDefinitionGroup>
		<ClCompile>
			<PreprocessorDefinitions>
				;PR_PIX_ENABLED=0
				;PR_COMPUTE_SHADER_DEBUG=0
				;%(PreprocessorDefinitions)
			</PreprocessorDefinitions>
			<AdditionalIncludeDirectories>
				;$(PixPackagePath)Include\WinPixEventRuntime
				;%(AdditionalIncludeDirectories)
			</AdditionalIncludeDirectories>
		</ClCompile>
		<Link>
			<AdditionalLibraryDirectories>
				;$(PixPackagePath)bin\$(PlatformName)
				;%(AdditionalLibraryDirectories)
			</AdditionalLibraryDirectories>
			<!--
			<AdditionalDependencies>
				;WinPixEventRuntime.lib - Don't use the import library, dynamically load PIX instead using rdr12::pix::LoadDll()
				;%(AdditionalDependencies)
			</AdditionalDependencies>
			-->
		</Link>
	</ItemDefinitionGroup>

</Project>
