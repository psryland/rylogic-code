<?xml version="1.0" encoding="utf-8"?>
<!--
Copies the optional View3DUI satellite beside native and managed consumers.
-->
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

	<!-- Add the configuration-appropriate runtime to managed outputs without packing a duplicate native asset. -->
	<ItemGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
		<Content Include="$(RylogicRoot)lib\x64\debug\view3d-ui.dll" Condition="Exists('$(RylogicRoot)lib\x64\debug\view3d-ui.dll')">
			<Link>lib\x64\debug\view3d-ui.dll</Link>
			<Pack>false</Pack>
			<CopyToOutputDirectory Condition="'$(Configuration)'=='Debug'">PreserveNewest</CopyToOutputDirectory>
		</Content>

		<Content Include="$(RylogicRoot)lib\x64\release\view3d-ui.dll" Condition="Exists('$(RylogicRoot)lib\x64\release\view3d-ui.dll')">
			<Link>lib\x64\release\view3d-ui.dll</Link>
			<Pack>false</Pack>
			<CopyToOutputDirectory Condition="'$(Configuration)'!='Debug'">PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<!-- Prefer the current source build over a stale transitive Rylogic.Native runtime. -->
	<Target Name="PreferSourceView3dUIRuntime" AfterTargets="ResolvePackageAssets" Condition="'$(MSBuildProjectExtension)' == '.csproj'">
		<ItemGroup>
			<RuntimeTargetsCopyLocalItems
				Remove="@(RuntimeTargetsCopyLocalItems)"
				Condition="Exists('$(RylogicRoot)lib\x64\$(Configuration)\view3d-ui.dll') AND '%(RuntimeTargetsCopyLocalItems.NuGetPackageId)' == 'Rylogic.Native' AND '%(RuntimeTargetsCopyLocalItems.Filename)%(RuntimeTargetsCopyLocalItems.Extension)' == 'view3d-ui.dll'" />
		</ItemGroup>
	</Target>

	<!-- Native applications load the satellite from their normal lib/platform/config directory. -->
	<ItemGroup Condition="'$(MSBuildProjectExtension)' == '.vcxproj'">
		<DependencyLink Include="$(RylogicRoot)lib\$(Platform)\$(Configuration)\view3d-ui.dll">
			<OutDir>$(OutDir)lib\$(Platform)\$(Configuration)\</OutDir>
		</DependencyLink>
	</ItemGroup>
</Project>
