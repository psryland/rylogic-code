<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

	<Import Project="$(MSBuildThisFileDirectory)..\props\dxc.props" />

	<!--
	The DXC package sets the FxCompile tool path to its own 'bin' directory, which contains 'dxc.exe' but not 'fxc.exe'.
	The standard FXC task picks 'dxc.exe' for shader model 6+ by itself, but the MultiToolTask shader path (used when UseMultiToolTask is true)
	does not. Naming the executable makes both paths use the package's compiler.
	-->
	<PropertyGroup>
		<FxCompileToolExe>dxc.exe</FxCompileToolExe>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Direct3D.DXC" />
		<PackageVersion Include="Microsoft.Direct3D.DXC" version="$(DxcPackageVersion)"/>
	</ItemGroup>

	<ItemGroup>
		<Content Include="$(DxcRuntimeDir)dxcompiler.dll">
			<Link>dxcompiler.dll</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="$(DxcRuntimeDir)dxil.dll">
			<Link>dxil.dll</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<BuildArtifacts Include="$(DxcRuntimeDir)dxcompiler.dll" />
		<BuildArtifacts Include="$(DxcRuntimeDir)dxil.dll" />
	</ItemGroup>

	<ItemDefinitionGroup>
		<Link>
			<AdditionalDependencies>
				;dxcompiler.lib
				;%(AdditionalDependencies)
			</AdditionalDependencies>
		</Link>
	</ItemDefinitionGroup>

</Project>
