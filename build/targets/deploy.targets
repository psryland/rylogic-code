<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<!--
	Deploy target: copies BuildArtifacts to DeployPath/Platform/Config/
	
	Usage: In your .vcxproj or .props, define BuildArtifacts items:
		<ItemGroup>
			<BuildArtifacts Include="$(OutDir)$(TargetName).lib" />
			<BuildArtifacts Include="$(OutDir)$(TargetName).pdb" />
		</ItemGroup>
	
	Projects that import lib.props or dll.props get sensible defaults automatically.
	Add extra BuildArtifacts items in the .vcxproj to deploy additional files.

	Production dynamic-library projects must set RylogicNativeRuntimePackage to Include or Exclude.
	Included projects contribute every DLL BuildArtifact to the runtime-only Rylogic.Native package.
	-->
	<PropertyGroup>
		<DeployDir>$(DeployPath)$(PlatformTarget)\$(Configuration)\</DeployDir>
		<RylogicNativeRuntimeManifestDir>$(RylogicRoot)obj\native-runtime-manifests\$(PlatformTarget)\$(Configuration)\</RylogicNativeRuntimeManifestDir>
		<RylogicNativeRuntimeManifest>$(RylogicNativeRuntimeManifestDir)$(MSBuildProjectName).txt</RylogicNativeRuntimeManifest>
	</PropertyGroup>

	<Target Name="Deploy" AfterTargets="Build" Condition="'@(BuildArtifacts)' != ''">
		<MakeDir Directories="$(DeployDir)" />
		<Copy
			SourceFiles="@(BuildArtifacts)"
			DestinationFolder="$(DeployDir)"
			SkipUnchangedFiles="true"
			Condition="Exists('%(Identity)')"
		/>
		<Message
			Text="Deployed %(BuildArtifacts.Filename)%(BuildArtifacts.Extension) --> $(DeployDir)"
			Importance="normal"
			Condition="Exists('%(Identity)')"
		/>
	</Target>

	<!-- Persist the evaluated DLL artifact list so package creation follows project-owned build metadata. -->
	<Target Name="WriteRylogicNativeRuntimeManifest" AfterTargets="Deploy" Condition="'$(RylogicNativeRuntimePackage)' == 'Include'">
		<ItemGroup>
			<_RylogicNativeRuntimeAsset Include="@(BuildArtifacts)" Condition="'%(BuildArtifacts.Extension)' == '.dll'" />
		</ItemGroup>
		<Error Condition="'@(_RylogicNativeRuntimeAsset)' == ''" Text="$(MSBuildProjectFullPath) is included in Rylogic.Native but declares no DLL BuildArtifacts." />
		<MakeDir Directories="$(RylogicNativeRuntimeManifestDir)" />
		<WriteLinesToFile File="$(RylogicNativeRuntimeManifest)" Lines="@(_RylogicNativeRuntimeAsset->'%(FullPath)')" Overwrite="true" Encoding="UTF-8" />
		<Message Text="Declared Rylogic.Native runtime assets --> $(RylogicNativeRuntimeManifest)" Importance="normal" />
	</Target>
</Project>
