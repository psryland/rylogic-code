<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

	<ItemGroup>
		<PropertyPageSchema Include="$(MSBuildThisFileDirectory)$(MSBuildThisFileName).xml"/>
		<AvailableItemName Include="ShaderBuild">
			<Targets>ShaderBuildTarget</Targets>
		</AvailableItemName>
	</ItemGroup>

	<PropertyGroup>
		<ShaderBuildStampDir Condition="'$(ShaderBuildStampDir)'==''">$(ProjectDir)src\shaders\hlsl\compiled\$(Configuration)\</ShaderBuildStampDir>
	</PropertyGroup>

	<!-- Allow shader items in different source roots to declare the directory where BuildShader writes their stamp. -->
	<ItemDefinitionGroup>
		<ShaderBuild>
			<StampDir>$(ShaderBuildStampDir)</StampDir>
		</ShaderBuild>
	</ItemDefinitionGroup>

	<ItemGroup>
		<ShaderBuildDependency Include="$(ProjectDir)src\**\*.hlsli" />
		<ShaderBuildDependency Include="$(RylogicRoot)include\pr\hlsl\*.hlsli" />
	</ItemGroup>

	<!-- Batch incrementally by source file so one stale shader does not rebuild every item. -->
	<Target
		Name="ShaderBuildTarget"
		BeforeTargets="CLCompile"
		Inputs="%(ShaderBuild.FullPath);@(ShaderBuildDependency);$(ScriptPath)BuildShader.csx;$(MSBuildThisFileFullPath)"
		Outputs="%(ShaderBuild.StampDir)%(ShaderBuild.Filename).built"
	>
		<!-- 
		<Message Importance="high" Text="%(ShaderBuild.Filename)%(ShaderBuild.Extension)" />
		<Message Importance="high" Text="INPUTS: @(ShaderBuild);$(ScriptPath)BuildShader.csx;$(MSBuildThisFileFullPath)" />
		-->

		<Exec Condition="$(Configuration) == 'Debug'"
			Command="dotnet-script.exe --cache-path &quot;$(TEMP)\rylogic-dotnet-script\$(SubDir)\BuildShader&quot; $(ScriptPath)BuildShader.csx %(ShaderBuild.FullPath) $(PlatformTarget) $(Configuration) model=%(ShaderBuild.ShaderModel) vs=%(ShaderBuild.VertexEntryPoints) ps=%(ShaderBuild.PixelEntryPoints) gs=%(ShaderBuild.GeometryEntryPoints) cs=%(ShaderBuild.ComputeEntryPoints) lib=%(ShaderBuild.LibraryTargets) dbg"
			ContinueOnError="ErrorAndContinue"
		/>
		<Exec Condition="$(Configuration) != 'Debug'"
			Command="dotnet-script.exe --cache-path &quot;$(TEMP)\rylogic-dotnet-script\$(SubDir)\BuildShader&quot; $(ScriptPath)BuildShader.csx %(ShaderBuild.FullPath) $(PlatformTarget) $(Configuration) model=%(ShaderBuild.ShaderModel) vs=%(ShaderBuild.VertexEntryPoints) ps=%(ShaderBuild.PixelEntryPoints) gs=%(ShaderBuild.GeometryEntryPoints) cs=%(ShaderBuild.ComputeEntryPoints) lib=%(ShaderBuild.LibraryTargets)"
			ContinueOnError="ErrorAndContinue"
		/>
	</Target>

	<!-- Delete the stamp files during Clean so Rebuild recompiles the generated shader headers. -->
	<Target
		Name="ShaderBuildClean"
		BeforeTargets="Clean"
	>
		<Delete Files="@(ShaderBuild->'%(StampDir)%(Filename).built')" />
	</Target>

	<!-- Hook the custom target into the build pipeline -->  
	<PropertyGroup>
		<BuildDependsOn>ShaderBuildTarget;$(BuildDependsOn)</BuildDependsOn>
	</PropertyGroup>

</Project>
