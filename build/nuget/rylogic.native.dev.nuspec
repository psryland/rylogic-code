<?xml version="1.0"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
	<metadata>
		<id>Rylogic.Native</id>
		<version>$version$</version>
		<authors>Rylogic</authors>
		<copyright>Copyright (c) Rylogic 2007</copyright>
		<license type="expression">MIT</license>
		<description>Native Debug runtime assets, public headers, supported native link libraries, and content cooking tools for local Rylogic library development.</description>
		<tags>rylogic native library local development tools</tags>
		<repository type="git" url="https://github.com/psryland/rylogic_code" />
		<requireLicenseAcceptance>false</requireLicenseAcceptance>
	</metadata>
	<files>
		<file src="build\**\*" target="build" />
		<file src="runtimes\**\*" target="runtimes" />
		<file src="tools\**\*" target="tools" />
	</files>
</package>
