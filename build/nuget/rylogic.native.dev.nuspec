<?xml version="1.0"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
	<metadata>
		<id>Rylogic.Native</id>
		<version>$version$</version>
		<authors>Rylogic</authors>
		<copyright>Copyright (c) Rylogic 2007</copyright>
		<license type="expression">MIT</license>
		<description>Native Debug runtime assets for local Rylogic library development.</description>
		<tags>rylogic native library local development</tags>
		<repository type="git" url="https://github.com/psryland/rylogic_code" />
		<requireLicenseAcceptance>false</requireLicenseAcceptance>
	</metadata>
	<files>
		<file src="*.dll" target="runtimes\win-x64\native" />
	</files>
</package>
